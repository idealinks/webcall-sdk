    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idealinks/webcall-sdk.git"
  },
  "homepage": "https://github.com/idealinks/webcall-sdk#readme",
  "keywords": [
    "vaibe",
    "voice",
    "ai",
    "webrtc",
    "thinkrr"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "microbundle": "^0.15.1"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "livekit-client": "^2.5.1"
  }
}
