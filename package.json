{
  "name": "webcall-sdk",
  "version": "3.0.1",
  "description": "Thinkrr fork of retell-client-js-sdk — LiveKit CloudFront / thinkrrVoice hosts.",
  "main": "dist/index.js",
  "module": "dist/index.m.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/write-version.js && microbundle --tsconfig tsconfig.json --no-sourcemap",
